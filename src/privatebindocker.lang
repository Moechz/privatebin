# ===========================================================================
# Multilingual file for the TOS 7 Docker application "privatebindocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "PrivateBin"
auth         = "PrivateBin"
version      = "@@VERSION@@"
descript     = "PrivateBin is a self-hosted zero-knowledge pastebin: the browser encrypts text before upload, so the server stores only ciphertext, and the key stays in the link fragment. Pastes expire after a chosen time or a number of reads, can be password protected and support comments and encrypted attachments. The official Docker Hub image runs as a non-root container; pastes live in the application data folder. Browser encryption needs a secure context, so open it over HTTPS."
release_note = "2.1.1-3 - Rectified per review comments (P2/C3/C4/C5/C6/C7/C9/C10/T1 + F3/F5/F7): help now points to a public privacy policy, the policy itself was written from scratch (stored data, retention, rights, security measures, third parties, deletion channel), README completed with repository layout / privacy / notices / build / data and uninstall, descriptions rewritten to match the delivered features (and to state the HTTPS requirement of browser-side encryption), config folder mounted so retention can be tuned in conf.php, and the stop behaviour fixed (SIGTERM forwarded, docker stop returns in under a second instead of being SIGKILLed after the grace period). Base image remains the latest upstream release 2.1.1, which fixes GHSA-6vvp-q86m-cp8q, GHSA-9rmv-j9gp-6vc5 and GHSA-c4gc-8mcm-hh65."
important    = "Open http://<NAS-IP>:8177. Needs DockerEngine (installed automatically if missing). Browsers only expose the WebCrypto API used for encryption on a secure origin: over plain HTTP the page opens but cannot create or decrypt pastes, so put the app behind a TLS reverse proxy or open http://127.0.0.1:8177 on the NAS itself. Pastes and settings live in DockerAppData/privatebindocker; delete that folder to erase everything."

[zh-cn]
name         = "PrivateBin"
auth         = "PrivateBin"
version      = "@@VERSION@@"
descript     = "PrivateBin 是自建的零知识加密粘贴板：文本在浏览器端加密后才上传，服务器只保存密文，解密密钥只存在于链接的 # 片段中。粘贴可按时限或阅读次数过期，可加密码保护，支持评论与加密附件；过期或阅后即焚后立即从服务器删除。本应用以非 root 容器运行官方 Docker Hub 镜像，粘贴保存在应用数据目录。浏览器加密需要安全上下文（HTTPS）。"
release_note = "2.1.1-3 — 针对上轮审核意见的整改（P2/C3/C4/C5/C6/C7/C9/C10/T1 + F3/F5/F7）：help 改指向公开的隐私政策；重写隐私政策（存储内容、保留期、用户权利、安全措施、第三方共享、删除渠道）；README 补齐仓库结构/隐私/声明/构建/数据与卸载；描述按真实功能重写并写明浏览器端加密需要 HTTPS；挂载 cfg 目录可用 conf.php 调整保留期；修复停止行为（转发 SIGTERM，docker stop 一秒内完成而非被强杀）。镜像仍为上游最新版 2.1.1，已修复 GHSA-6vvp-q86m-cp8q、GHSA-9rmv-j9gp-6vc5、GHSA-c4gc-8mcm-hh65。"
important    = "在 http://<NAS-IP>:8177 打开（需要 DockerEngine，缺失时自动安装）。浏览器只在 HTTPS 等安全上下文下提供 WebCrypto 加密接口：用纯 HTTP 打开时页面能显示，但无法创建或解密粘贴，请通过带 TLS 的反向代理访问，或在本机用 http://127.0.0.1:8177。粘贴与设置保存在 DockerAppData/privatebindocker，删除该目录即清空全部内容。"

[zh-hk]
name         = "PrivateBin"
auth         = "PrivateBin"
version      = "@@VERSION@@"
descript     = "PrivateBin 是自建的零知識加密貼上板：文字在瀏覽器端加密後才上傳，伺服器只保存密文，解密密鑰只存在於連結的 # 片段中。貼上可按時限或閱讀次數過期，可加密碼保護，支援評論與加密附件；過期或閱後即焚後立即從伺服器刪除。本應用以非 root 容器執行官方 Docker Hub 映像，貼上保存在應用資料目錄。瀏覽器加密需要安全上下文（HTTPS）。"
release_note = "2.1.1-3 — 針對上輪審核意見的整改（P2/C3/C4/C5/C6/C7/C9/C10/T1 + F3/F5/F7）：help 改指向公開的隱私政策；重寫隱私政策（儲存內容、保留期、使用者權利、安全措施、第三方分享、刪除管道）；README 補齊倉庫結構/隱私/聲明/建置/資料與卸載；描述按真實功能重寫並註明瀏覽器端加密需要 HTTPS；掛載 cfg 目錄可用 conf.php 調整保留期；修正停止行為（轉發 SIGTERM，docker stop 一秒內完成而非被強制終止）。映像仍為上游最新版 2.1.1，已修正 GHSA-6vvp-q86m-cp8q、GHSA-9rmv-j9gp-6vc5、GHSA-c4gc-8mcm-hh65。"
important    = "在 http://<NAS-IP>:8177 開啟（需要 DockerEngine，缺少時自動安裝）。瀏覽器只在 HTTPS 等安全上下文下提供 WebCrypto 加密介面：用純 HTTP 開啟時頁面能顯示，但無法建立或解密貼上，請透過帶 TLS 的反向代理存取，或在本機用 http://127.0.0.1:8177。貼上與設定保存在 DockerAppData/privatebindocker，刪除該目錄即清空全部內容。"

